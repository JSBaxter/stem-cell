{% raw -%}
# Thin caller for the cell ceremony trigger. All logic lives in the reusable
# workflow JSBaxter/harness/.github/workflows/cell-ceremony.yml: when a pull
# request closes by merging, it marks every issue the PR closed `state:done`
# through cellq, counts the cell's merged PRs, and files a ceremony issue for
# each ceremony whose period in thresholds.yml divides that count. No Claude
# session starts here. Changes there reach this cell through a bump PR with
# no edit here — this stub only wires the pull-request trigger, the token
# scopes, and secrets. See harness ADR 0001, 0006 and 0008.
#
# IMPORTANT — primary-identity repos ONLY. A stealth-identity repo must NOT
# reference JSBaxter/* (it would link the accounts in plaintext); it keeps a
# self-contained copy instead.
#
# Pin: a full commit SHA with the branch in a trailing comment (harness ADR
# 0006). Renovate opens a bump PR here when the harness moves; do not edit the
# SHA by hand.
name: Cell Ceremony

on:
  pull_request:
    # Fires for a close without a merge too; the reusable workflow holds the
    # merged guard, so that run skips in seconds.
    types: [closed]

# A reusable-workflow caller caps the called workflow at the caller's token
# scopes, and a repo's default GITHUB_TOKEN is read-only — so grant here the
# scopes the ceremony step needs (read the checkout, write issue labels and
# file issues) or the call fails to start.
permissions:
  contents: read
  issues: write

jobs:
  ceremony:
{% endraw %}
    uses: JSBaxter/harness/.github/workflows/cell-ceremony.yml@{{ harness_ref }} # main
    secrets: inherit
