# Cell .gitignore — managed by stem-cell, edit freely.

# Local environment / secrets
.env
.env.*
!.env.example

# Build / cache
.venv/

# Python build artifacts — always present because the bundled queue
# under dev-tools/queue/ is Python regardless of the cell's primary
# language. .pytest_cache is included here for the same reason.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
{% if language == "python" %}
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
{% endif %}

# Queue runtime state — code is committed; the live DB is not.
dev-tools/queue/queue.db
dev-tools/queue/queue.db-*

{% if include_bot_identity %}
# Bot identity credentials
.agent-bot/
{% endif %}

# Editor / OS
.idea/
.vscode/
.DS_Store

# Copier answers ARE committed (lineage / update support).
# Do not add .copier-answers.yml here.
